{
  "kind": "collectionType",
  "collectionName": "guides",
  "info": {
    "singularName": "guide",
    "pluralName": "guides",
    "displayName": "Guide",
    "description": "Published user and tenant administrator documentation."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 3,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "audience": {
      "type": "enumeration",
      "enum": ["all", "tenant_admin", "user"],
      "default": "all",
      "required": true
    },
    "section": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "sortOrder": {
      "type": "integer",
      "default": 100
    },
    "readingMinutes": {
      "type": "integer",
      "min": 1,
      "default": 3
    },
    "body": {
      "type": "text",
      "required": true
    }
  }
}
