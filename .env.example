CHARGEPILOT_SECRET_KEY=change-me-in-production
CHARGEPILOT_DATABASE_URL=postgresql+psycopg://chargepilot:your_password@YOUR_POSTGRES_HOST:5432/chargepilot
CHARGEPILOT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CHARGEPILOT_ADMIN_USERNAME=admin
CHARGEPILOT_ADMIN_PASSWORD=change-me
CHARGEPILOT_TELEMETRY_RATE_LIMIT_PER_MINUTE=60
CHARGEPILOT_ENDPOINT_OFFLINE_TIMEOUT_SECONDS=600

# If the app is running inside Docker and the database is on the host machine,
# use host.docker.internal for the host name, for example:
# CHARGEPILOT_DATABASE_URL=postgresql+psycopg://chargepilot:your_password@host.docker.internal:5432/chargepilot
